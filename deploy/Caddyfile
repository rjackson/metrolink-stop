# Installed verbatim to /etc/caddy/Caddyfile by deploy/proxmox-install.sh, so
# the paths here must agree with that script and deploy/build-release.sh.
#
# Plain HTTP: TLS is terminated by the Cloudflare tunnel in front.
{
	auto_https off
}

:80 {
	root * /srv/metrolink-stop/current/www
	encode zstd gzip

	# Vite content-hashes everything under /assets/, so a changed file always
	# gets a new URL and these can be cached forever, by browsers and by
	# Cloudflare. Only for files that exist: a 404 must not be cached.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, sw.js, icon.svg, every page URL, and missing
	# assets) must be revalidated on every load, to pick up new releases.
	@unhashed {
		not {
			path /assets/*
			file
		}
	}
	header @unhashed Cache-Control "no-cache"

	# Single page app: any path that isn't a file serves index.html. Not for
	# /assets/, where a missing file is a genuine 404 rather than a page.
	@spa {
		not path /assets/*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa {file_match.relative}

	file_server
}
