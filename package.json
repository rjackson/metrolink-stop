{
  "name": "metrolink-stop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.tsx --max-warnings 0 App.tsx main.tsx vite.config.ts pages components lib utils scripts",
    "regenerate-stop-lines": "tsx scripts/regenerate-stop-lines.ts",
    "check-data": "tsx scripts/check-data.ts",
    "regenerate-gtfs-stops": "npm run gtfs-prepare && npm run gtfs-stops",
    "regenerate-gtfs-isochrones": "npm run gtfs-prepare && npm run gtfs-stop-times && npm run gtfs-isochrones",
    "gtfs-prepare": "(cd ./data/lines; bash prepare.sh)",
    "gtfs-stops": "(cd ./data/lines; node process-stops.mjs)",
    "gtfs-stop-times": "(cd ./data/lines; Rscript calculate-stop-times.R)",
    "gtfs-isochrones": "(cd ./data/lines; node process-isochrones.mjs)",
    "type-check": "tsc --pretty --noEmit"
  },
  "pre-commit": [
    "lint",
    "type-check"
  ],
  "dependencies": {
    "@react-hook/media-query": "^1.1.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@rjackson/rjds": "^0.4.0",
    "esri-leaflet-vector": "^4.3.2",
    "fathom-client": "^3.4.1",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-is": "^18.1.0",
    "react-leaflet": "^4.2.1",
    "react-router": "^7.18.5",
    "react-spinners": "^0.17.1",
    "react-use": "^17.4.0",
    "styled-components": "^5.3.5",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.10",
    "@types/leaflet": "^1.9.3",
    "@types/node": "^18.11.9",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.13",
    "csv-parse": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.19",
    "pre-commit": "^1.2.2",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.2.4",
    "tsx": "^4.23.15",
    "typescript": "^4.9.5",
    "vite": "^6.4.5"
  }
}
