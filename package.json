{
  "name": "metrolink-stop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "regenerate-stop-lines": "tsx scripts/regenerate-stop-lines.ts",
    "check-data": "tsx scripts/check-data.ts",
    "regenerate-gtfs": "npm run gtfs-prepare && npm run gtfs-stop-times && npm run gtfs-isochrones && npm run gtfs-stops && npm run gtfs-line-stops && npm run gtfs-link-shapes",
    "gtfs-prepare": "(cd ./data/lines; bash prepare.sh)",
    "gtfs-stops": "(cd ./data/lines; node process-stops.mjs)",
    "gtfs-stop-times": "(cd ./data/lines; Rscript calculate-stop-times.R)",
    "gtfs-isochrones": "(cd ./data/lines; node process-isochrones.mjs)",
    "gtfs-line-stops": "(cd ./data/lines; node process-line-stops.mjs)",
    "gtfs-link-shapes": "(cd ./data/lines; node process-link-shapes.mjs)",
    "type-check": "tsc --pretty --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@react-hook/media-query": "^1.1.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@rjackson/rjds": "^0.6.0",
    "esri-leaflet-vector": "^4.3.2",
    "fathom-client": "^3.4.1",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.5",
    "react-spinners": "^0.17.1",
    "react-use": "^17.4.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run type-check"
  }
}
